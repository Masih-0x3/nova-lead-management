# Supabase Postgres. Use the Supabase transaction pooler URI in Vercel.
DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_MAX_CONNECTIONS=1

# Google Places API (New) - required for lead discovery and enrichment.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Optional Google Maps JavaScript API key for the Explorer's opt-in browser map.
# Restrict this key by HTTP referrer in Google Cloud and set a low quota/budget.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_browser_restricted_google_maps_key_here

# Supabase Auth. Use the Project URL, publishable key, and service_role key from Supabase.
NEXT_PUBLIC_APP_URL=https://your-app-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NOVA_BOOTSTRAP_ADMIN_EMAIL=you@example.com
NOVA_ENCRYPTION_SECRET=replace_with_at_least_32_random_characters
WORKER_CRON_SECRET=replace_with_a_random_secret_also_saved_in_supabase_vault
WORKER_ROUTE_TIMEOUT_MS=45000

# OpenAI lead verification. The app refuses any model other than gpt-5.4-mini.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AI_COST_RESERVATION_USD=0.05

# Worker lease roles (L-01). The issuer acquires durable leases and the
# resolver authorizes the five worker routes; each connection uses its own
# restricted role. `npm run local:seed` provisions the roles on loopback
# PostgreSQL (including local Supabase at 127.0.0.1:54322) and prints the
# exact URLs to copy here. Missing or malformed configuration fails closed.
TENANT_WORKER_LEASE_ISSUER_DATABASE_URL=postgresql://novatrade_worker_lease_issuer:replace_me@127.0.0.1:54322/postgres
TENANT_WORKER_LEASE_RESOLVER_DATABASE_URL=postgresql://novatrade_worker_lease_resolver:replace_me@127.0.0.1:54322/postgres

# L-01 local runtime seeding (scripts/seed-local-tenant.mjs). Passwords default
# to generated values printed once by the seed. LOCAL_SEED_ALLOW_REMOTE=1 is
# required to seed any non-loopback database; keep this unset for local use.
# LOCAL_ADMIN_PASSWORD=replace_me_or_leave_generated
# LOCAL_RESEARCHER_PASSWORD=replace_me_or_leave_generated
# LOCAL_WORKER_LEASE_ISSUER_PASSWORD=replace_me_or_leave_generated
# LOCAL_WORKER_LEASE_RESOLVER_PASSWORD=replace_me_or_leave_generated
# LOCAL_TENANT_SLUG=local-demo
# LOCAL_ADMIN_EMAIL=admin@nova.local
# LOCAL_RESEARCHER_EMAIL=researcher@nova.local

# AI cost guardrail defaults exposed in Settings.
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=25
AI_BATCH_LIMIT=25
AI_CACHE_TTL_DAYS=30

# L-03 document intake: runtime object-store and malware-scanner backends.
# Production selects the real providers; there is no implicit default and any
# incomplete combination fails closed at startup.
NOVA_DOCUMENT_STORAGE_BACKEND=supabase
NOVA_DOCUMENT_SCANNER_BACKEND=clamd
NOVA_SCANNER_POLICY_VERSION=launch-v1

# Private Supabase Storage backend. The origin must be exact HTTPS with no
# port, path, or credentials; the bucket must already exist and stay private.
# NOVA_SUPABASE_STORAGE_ALLOWED_* are comma-separated allowlists defaulting to
# the configured origin/bucket. SUPABASE_SERVICE_ROLE_KEY (above) is required.
NOVA_SUPABASE_STORAGE_ORIGIN=https://your-project-ref.supabase.co
NOVA_SUPABASE_STORAGE_BUCKET=nova-quarantine
# NOVA_SUPABASE_STORAGE_ALLOWED_BUCKETS=nova-quarantine
# NOVA_SUPABASE_STORAGE_ALLOWED_ORIGINS=https://your-project-ref.supabase.co
# NOVA_SUPABASE_STORAGE_TIMEOUT_MS=10000
# NOVA_SUPABASE_STORAGE_TLS_CA_FILE=/path/to/extra-ca.pem

# ClamAV clamd backend. The engine version must match the approved build;
# the scanner reads quarantine bytes through the configured object source.
NOVA_CLAMD_HOST=clamd.internal
NOVA_CLAMD_PORT=3310
NOVA_CLAMD_CONNECT_TIMEOUT_MS=5000
NOVA_CLAMD_SCAN_TIMEOUT_MS=120000
NOVA_SCANNER_APPROVED_ID=clamd-instream
NOVA_SCANNER_APPROVED_VERSION=1.5.4

# Local-only acceptance gate. Selecting either "local" backend requires this
# explicit opt-in; it is for local acceptance runs only, never production.
# NOVA_DOCUMENT_LOCAL_ACCEPTANCE=1
# NOVA_DOCUMENT_STORE_ROOT=.data/document-objects
# NOVA_DOCUMENT_SIGNING_SECRET=replace_with_a_random_secret
# NOVA_DOCUMENT_UPLOAD_ORIGIN=http://localhost:3000
# NOVA_SCANNER_BLOCKED_SHA256=comma_separated_sha256_hex
